ro.config.vc_call_vol_steps=7
ro.config.media_vol_steps=25
ro.vendor.audio.sdk.ril=true
vendor.audio.adm.allow_dynamic_snd_device=true
vendor.audio.dolby.ds2.enabled=true
vendor.audio.dolby.ds2.hardbypass=false
vendor.audio.feature.a2dp_offload=true
vendor.audio.feature.afe_proxy=true
