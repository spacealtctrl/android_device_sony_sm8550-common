vendor.audio.feature.usb_offload.enable=true
vendor.audio.feature.usb_offload_burst_mode.enable=true
vendor.audio.feature.usb_offload_sidetone_volume.enable=false
vendor.audio.feature.deepbuffer_as_primary.enable=false
vendor.audio.feature.vbat.enable=true
vendor.audio.feature.wsa.enable=false
vendor.audio.feature.audiozoom.enable=false
vendor.audio.feature.snd_mon.enable=true
vendor.audio.feature.dmabuf.cma.memory.enable=false
vendor.audio.hdr.record.enable=false
vendor.audio.enable.cirrus.speaker=true
vendor.voice.path.for.pcm.voip=true
vendor.audio.feature.fullduplex=true
vendor.audio.feature.gapless_playback=true
vendor.audio.feature.generic_custom_stereo=true
vendor.audio.feature.hearing_aid=true
vendor.audio.feature.hwdep=true
vendor.audio.feature.keep_alive=true
vendor.audio.feature.kpi_optimize=true
vendor.audio.feature.ma_audio=true
vendor.audio.feature.mismatched_sample_rates=true
vendor.audio.feature.multi_voice_session=true
vendor.audio.feature.ols_hal=true
vendor.audio.feature.pause_in_voip_call=true
vendor.audio.feature.perf_voice_call=true
vendor.audio.feature.phone_mic=true
vendor.audio.feature.power_tag=true
vendor.audio.feature.pwr_mode_aware_snd_device=true
vendor.audio.feature.qaf=true
vendor.audio.feature.qas=false
vendor.audio.feature.record_play_concurency=false
vendor.audio.feature.ras=true
vendor.audio.feature.render_feedback=true
vendor.audio.feature.separate_offload_vol_ctl=true
vendor.audio.feature.snd_mon=true
vendor.audio.feature.speaker_protection=true
vendor.audio.feature.spkr_prot=true
vendor.audio.feature.src_trkn=true
vendor.audio.feature.ssrec=true
vendor.audio.feature.surround_sound=true
vendor.audio.feature.usb_offload=true
vendor.audio.feature.usb_offload_burst_mode=true
vendor.audio.feature.usb_offload_sidetone_volume=false
vendor.audio.feature.vbat=true
vendor.audio.feature.voice_dsd=true
vendor.audio.feature.wsa=false
vendor.audio.hal.boot.timeout.ms=600
vendor.audio.hal.in.depth_ms=18
vendor.audio.offload.track.enable=true
vendor.audio_hal.audio_format_map=AUDIO_FORMAT_MP3,10;AUDIO_FORMAT_AAC,2;AUDIO_FORMAT_AAC_MAIN,16;AUDIO_FORMAT_AAC_LC,2;AUDIO_FORMAT_AAC_SSR,4;AUDIO_FORMAT_AAC_LTP,8;AUDIO_FORMAT_AAC_ADIF,32;AUDIO_FORMAT_AAC_XHE,64;AUDIO_FORMAT_AAC_LATM,128;AUDIO_FORMAT_AAC_ADTS,256;AUDIO_FORMAT_FLAC,9;AUDIO_FORMAT_ALAC,21;AUDIO_FORMAT_DSD,20;AUDIO_FORMAT_DFF,28;AUDIO_FORMAT_DSF,29;AUDIO_FORMAT_SBC,19;AUDIO_FORMAT_APTX,22;AUDIO_FORMAT_APTX_HD,23;AUDIO_FORMAT_LDAC,24;AUDIO_FORMAT_CELT,25;AUDIO_FORMAT_APTX_ADAPTIVE,26;AUDIO_FORMAT_APTX_TWSP,27;
vendor.audio.use.sw.alac.decoder=true
vendor.audio.use.sw.ape.decoder=true
vendor.audio.use.sw.mpegh.decoder=true
vendor.audio.volume.headset.gain.depcal=true

# Bluetooth
bluetooth.a2dp.aac_frame_ctrl=true
bluetooth.a2dp.fec.supported=true
bluetooth.a2dp_offload.cap=sbc-aptx-aptxhd-aptxadaptive-ldac
bluetooth.a2dp_offload.enabled=true
bluetooth.hardware.power.idle_cur_ma=6
bluetooth.hardware.power.operating_cur_ma=142
bluetooth.hfp.client=true
ro.bluetooth.a2dp_offload.supported=true
ro.vendor.bt.bdaddr_path=/data/vendor/bluetooth/bt_devaddr
ro.vendor.extension_library=/vendor/lib/rfsa/adsp/libqtigamedp.so
vendor.qti.bt.soc=hastings

# Bluetooth LE Audio
bluetooth.leaudio.dual_bidirection_swb.supported=true
persist.bluetooth.leaudio.allow.multiple.contexts=false
persist.bluetooth.leaudio.bypass_allow_list=true
persist.bluetooth.leaudio.notify.idle.during.call=true
persist.bluetooth.leaudio_offload.disabled=false
ro.bluetooth.leaudio_offload.supported=true
persist.enable.bluetooth.voipleawar=true

# Camera
camera.disable_zsl_mode=true

# Dalvik
dalvik.vm.image-dex2oat-Xms=64m
dalvik.vm.image-dex2oat-Xmx=64m
dalvik.vm.isa.arm.features=default
dalvik.vm.isa.arm.variant=cortex-a75
dalvik.vm.isa.arm64.features=default
dalvik.vm.isa.arm64.variant=cortex-a76
dalvik.vm.systemuicompilerfilter=speed
dalvik.vm.usejit=true
dalvik.vm.usejitprofiles=true

# Display
debug.sf.disable_client_composition_cache=true
debug.sf.enable_hwc_vds=1
persist.sys.sf.color_saturation=1.0
ro.opengles.version=196614
ro.surface_flinger.force_hwc_copy_for_virtual_displays=true
ro.surface_flinger.has_HDR_display=true
ro.surface_flinger.max_frame_buffer_acquired_buffers=3
ro.surface_flinger.set_idle_timer_ms=4000
ro.surface_flinger.set_touch_timer_ms=200

# DPM
persist.dpm.feature=9

# DRM
drm.service.enabled=true

# FM Radio
ro.fm.transmitter=false

# Graphics
debug.composition.type=c2
debug.force_rtl=0
debug.hwui.drop_shadow_cache_size=6
debug.hwui.gl_cores=4
debug.hwui.gradient_cache_size=1
debug.hwui.layer_cache_size=48
debug.hwui.path_cache_size=32
debug.hwui.text_large_cache_height=1024
debug.hwui.text_large_cache_width=2048
debug.hwui.text_small_cache_height=1024
debug.hwui.text_small_cache_width=1024
debug.hwui.texture_cache_flushrate=0.4
debug.hwui.texture_cache_size=72
persist.sys.perf_profile=1
ro.hardware.keystore=sm8550
ro.hwui.drop_shadow_cache_size=6
ro.hwui.gradient_cache_size=1
ro.hwui.layer_cache_size=48
ro.hwui.path_cache_size=32
ro.hwui.text_large_cache_height=1024
ro.hwui.text_large_cache_width=2048
ro.hwui.text_small_cache_height=1024
ro.hwui.text_small_cache_width=1024
ro.hwui.texture_cache_flushrate=0.4
ro.hwui.texture_cache_size=72

# Media
debug.stagefright.ccodec=4
debug.stagefright.omx_default_rank=512
media.c2.dmabuf.padding_enabled=1

# NFC
ro.nfc.port=I2C

# Qualcomm System Daemon
persist.vendor.qcomsysd.enabled=1

# Radio
DEVICE_PROVISIONING_REQUIRED=1
MODEM_POWER_MODE_DISABLED=0
persist.radio.atfwd.start=true
persist.vendor.radio.enable_prettyip=1
persist.vendor.radio.enableadvancedscan=true
ro.telephony.default_network=33,33
ro.telephony.use_old_mnc_mcc=true
ro.vendor.extension_library=/vendor/lib/rfsa/adsp/libqtigamedp.so
telephony.active_modems.max_count=2

# RmtStorage
rmt_storage.bootloader_board_id=0x00040001
rmt_storage.device_count=2

# Sensors
persist.vendor.sensors.direct_channel.buffer_size=16

# SSC/SLPI
persist.vendor.sensors.sscrpcd_available=1
persist.vendor.sensors.sscrpcd_enabled=1

# USB
persist.sys.usb.config=adb
vendor.usb.use_ffs_mtp=1
