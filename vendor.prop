# Qualcomm System Daemon
persist. vendor.qcomsysd.enabled=1

# Radio
DEVICE_PROVISIONING_REQUIRED=1
MODEM_POWER_MODE_DISABLED=0
persist.radio.atfwd.start=true
persist. vendor.radio.enable_prettyip=1
