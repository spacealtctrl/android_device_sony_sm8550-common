# Dolby DMS HAL
type hal_dms, domain;
type hal_dms_exec, exec_type, vendor_file_type, file_type;

# Allow hal_dms to be a HAL server domain
hal_server_domain(hal_dms, hal_dms_hwservice)

# Allow hal_dms to register the hwservice
add_hwservice(hal_dms, hal_dms_hwservice)

# Allow binder IPC
binder_use(hal_dms)
binder_call(hal_dms, hal_audio_default)

# Allow hal_dms to access vendor data files
allow hal_dms vendor_dolby_data_file:dir rw_dir_perms;
allow hal_dms vendor_dolby_data_file:file create_file_perms;
