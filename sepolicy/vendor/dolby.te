# Dolby Audio HAL sepolicy override
# This file overrides/supplements vendor/dolby sepolicy for Android 16 compatibility

# Define the vendor_dolby_data_file type if not already defined
type vendor_dolby_data_file, file_type, data_file_type;

# Allow hal_audio_default to find (but NOT add) the DMS hwservice
# The hal_dms domain will handle service registration
allow hal_audio_default hal_dms_hwservice:hwservice_manager find;

# Allow hal_audio_default to communicate with hal_dms via binder
binder_call(hal_audio_default, hal_dms)

# Allow hal_audio_default to access Dolby data files
allow hal_audio_default vendor_dolby_data_file:dir rw_dir_perms;
allow hal_audio_default vendor_dolby_data_file:file create_file_perms;
